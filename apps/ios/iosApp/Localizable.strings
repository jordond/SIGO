/* Spoken when the score is YES. %1$@ = location name, %2$@ = formatted temperature. */
"siri_intent_yes_dialog" = "Yes, conditions look great in %1$@. It's %2$@.";

/* Spoken when the score is MAYBE. %1$@ = location, %2$@ = temp. */
"siri_intent_maybe_dialog" = "Maybe. It's %2$@ in %1$@ right now.";

/* Spoken when the score is NO. %1$@ = location, %2$@ = temp. */
"siri_intent_no_dialog" = "No, conditions aren't great in %1$@. It's %2$@.";

/* Spoken when the user has never opened the SIGO app on their phone. */
"siri_intent_no_location_dialog" = "Open SIGO on your phone first to set a location.";

/* Spoken when the network is unreachable and there is no cached score. */
"siri_intent_unreachable_dialog" = "I couldn't reach the forecast right now.";

/* Appended after the verdict when the score is from a stale cache. */
"siri_intent_stale_suffix" = "(cached)";
